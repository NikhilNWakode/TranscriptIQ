# ---------------------------------------------------------------------------
# TranscriptIQ configuration. Copy to .env and fill in. Never commit .env.
# Keys are read by the backend only; nothing here is exposed to the browser.
# ---------------------------------------------------------------------------

# --- LLM provider: gemini | anthropic | openai_compatible | mock ----------
# mock = no API key, deterministic extractive answers (verbatim excerpts).
#
# FREE option (recommended to start): Google Gemini
#   1. Create a free key at https://aistudio.google.com/apikey
#   2. LLM_PROVIDER=gemini, LLM_API_KEY=<key>, EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
# Only for openai_compatible (Groq default) or a proxy:
LLM_BASE_URL=
# Anthropic only, optional: low | medium | high | xhigh | max
LLM_EFFORT=
LLM_TIMEOUT_S=120

# Examples
#   Gemini (free tier):   LLM_PROVIDER=gemini     LLM_MODEL=gemini-2.5-flash
#   Claude:               LLM_PROVIDER=anthropic  LLM_MODEL=claude-opus-5
#   Groq (free tier):     LLM_PROVIDER=openai_compatible LLM_MODEL=llama-3.3-70b-versatile
#                         LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter (free models): LLM_PROVIDER=openai_compatible LLM_BASE_URL=https://openrouter.ai/api/v1
#                         LLM_MODEL=<any ":free" model id>
#   Ollama (local, free): LLM_PROVIDER=openai_compatible LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=llama3.1

# --- Embeddings: local | gemini | openai_compatible ------------------------
# local = offline hashed lexical vectors (no key). gemini = gemini-embedding-001 (free tier).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
# Falls back to LLM_API_KEY when empty
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Storage / data ---------------------------------------------------------
TRANSCRIPTS_DIR=transcripts
INTERVIEW_GUIDE_PATH=config/interview_guide.json
DATABASE_PATH=backend/data/transcriptiq.db
PROJECT_ID=default
# Comma-separated document-conversion artifacts to strip (never shown as evidence)
ARTIFACT_TOKENS=canvas

# --- Retrieval tuning ---------------------------------------------------------
SEMANTIC_WEIGHT=0.6
PER_EXPERT_K=3
MAX_CONTEXT_SEGMENTS=40
GUIDE_BATCH_SIZE=8

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
